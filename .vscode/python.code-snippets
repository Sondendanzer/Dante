    "fascinante_18_collatz_con_memoizacion": {
        "prefix": "fascinante_collatz2",
        "body": [
            "# ENUNCIADO:",
            "# Analiza la secuencia de Collatz del 1 al N. Usa memoización (caché) para evitar recalcular. Encuentra el número con más pasos.",
            "",
            "# El diccionario guarda resultados ya calculados.",
            "cache = {1: 0}",
            "",
            "def contar_pasos_collatz(numero):",
            "    original = numero",
            "    secuencia = []",
            "",
            "    while numero not in cache:",
            "        secuencia.append(numero)",
            "",
            "        if numero % 2 == 0:",
            "            numero = numero // 2",
            "        else:",
            "            numero = 3 * numero + 1",
            "",
            "    pasos = cache[numero]",
            "",
            "    # Se guardan en caché los valores recorridos.",
            "    while len(secuencia) > 0:",
            "        valor = secuencia.pop()",
            "        pasos += 1",
            "        cache[valor] = pasos",
            "",
            "    return cache[original]",
            "",
            "def buscar_mayor_collatz(limite):",
            "    numero_mayor = 1",
            "    mayor_cantidad = 0",
            "",
            "    for numero in range(1, limite + 1):",
            "        pasos = contar_pasos_collatz(numero)",
            "",
            "        if pasos > mayor_cantidad:",
            "            mayor_cantidad = pasos",
            "            numero_mayor = numero",
            "",
            "    return numero_mayor, mayor_cantidad",
            "",
            "# Programa principal.",
            "n = int(input(\"Ingrese el valor de N: \"))",
            "numero, pasos = buscar_mayor_collatz(n)",
