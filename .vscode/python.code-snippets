        "body": [
            "# ENUNCIADO:",
            "# El usuario ingresa un número y debe mostrar los n primeros números pares.",
            "",
            "print(\"=\" * 31)",
            "print(\"    PRIMEROS NÚMEROS PARES    \")",
            "print(\"=\" * 31)",
            "",
            "",
            "# La función verifica si un número es par.",
            "def es_par(num):",
            "    if num % 2 == 0:",
            "        return num",
            "",
            "    return",
            "",
            "",
            "# La función imprime los primeros n números pares.",
            "def imprimir_pares(n):",
            "    contador = 0",
            "    num = 2",
            "",
            "    while contador < n:",
            "        if es_par(num) != None:",
            "            print(num)",
            "            contador += 1",
            "",
            "        # Se prueba el siguiente número.",
            "        num += 1",
            "",
            "",
            "# Programa principal.",
            "while True:",
            "    try:",
            "        usuario = int(input(\"Ingrese una cantidad de números pares: \"))",
            "",
            "        if usuario <= 0:",
            "            print(\"La cantidad debe ser mayor que cero.\")",
            "        else:",
            "            imprimir_pares(usuario)",
            "            break",
            "",
            "    except ValueError:",
            "        print(\"Ingrese un número entero válido.\")"
        ],
        "description": "Muestra los primeros n números pares mediante funciones y un bucle while."
    },
    "especialmente_05_calculo_figuras_con_clases": {
        "prefix": "especialmente_figuras",
        "body": [
            "# ENUNCIADO:",
            "# Elaborar un algoritmo que permita elegir entre 3 figuras: círculo, cuadrilátero o triángulo rectángulo.",
            "# Dependiendo de la figura elegida, solicitará el radio, los lados del cuadrilátero",
            "# o la base y altura, respectivamente.",
            "# Una vez ingresados los datos, deberá mostrar el perímetro y el área de la figura elegida.",
            "# Finalmente, consultará si desea realizar otro cálculo y, de responder sí,",
            "# deberá elegir nuevamente la figura y repetir los siguientes pasos.",
            "# Trabajar el algoritmo aplicando clases y métodos.",
            "",
            "import math",
            "",
            "",
            "# Clase para calcular el área y perímetro de un círculo.",
            "class Circulo:",
            "    def __init__(self, radio):",
            "        self.radio = radio",
            "",
            "    def area(self):",
            "        return math.pi * (self.radio ** 2)",
            "",
            "    def perimetro(self):",
            "        return 2 * math.pi * self.radio",
            "",
            "",
            "# Clase para calcular el área y perímetro de un cuadrilátero rectangular.",
            "class Cuadrilatero:",
            "    def __init__(self, lado1, lado2):",
            "        self.lado1 = lado1",
            "        self.lado2 = lado2",
            "",
            "    def area(self):",
            "        return self.lado1 * self.lado2",
            "",
            "    def perimetro(self):",
            "        return 2 * (self.lado1 + self.lado2)",
            "",
            "",
            "# Clase para calcular el área y perímetro de un triángulo rectángulo.",
            "class TrianguloRectangulo:",
            "    def __init__(self, base, altura):",
            "        self.base = base",
            "        self.altura = altura",
            "",
            "    def area(self):",
            "        return (self.base * self.altura) / 2",
            "",
            "    def perimetro(self):",
            "        hipotenusa = math.sqrt((self.base ** 2) + (self.altura ** 2))",
            "        return self.base + self.altura + hipotenusa",
            "",
            "",
            "# Programa principal.",
            "while True:",
            "    print(\"=\" * 31)",
            "    print(\"       DATOS DE FIGURA       \")",
            "    print(\"=\" * 31)",
            "    print(\"1. Círculo\")",
            "    print(\"2. Cuadrilátero\")",
            "    print(\"3. Triángulo rectángulo\")",
            "",
            "    figura = input(\"Ingrese el número de la figura elegida: \")",
            "",
            "    try:",
            "        if figura == \"1\":",
            "            radio = float(input(\"Ingrese el radio del círculo: \"))",
            "",
            "            if radio <= 0:",
            "                print(\"El radio debe ser mayor que cero.\")",
            "                continue",
            "",
            "            circulo = Circulo(radio)",
            "            print(f\"Área del círculo: {circulo.area():.2f}\")",
            "            print(f\"Perímetro del círculo: {circulo.perimetro():.2f}\")",
            "",
            "        elif figura == \"2\":",
            "            lado1 = float(input(\"Ingrese el primer lado del cuadrilátero: \"))",
            "            lado2 = float(input(\"Ingrese el segundo lado del cuadrilátero: \"))",
            "",
            "            if lado1 <= 0 or lado2 <= 0:",
            "                print(\"Los lados deben ser mayores que cero.\")",
            "                continue",
            "",
            "            cuadrilatero = Cuadrilatero(lado1, lado2)",
            "            print(f\"Área del cuadrilátero: {cuadrilatero.area():.2f}\")",
            "            print(f\"Perímetro del cuadrilátero: {cuadrilatero.perimetro():.2f}\")",
            "",
            "        elif figura == \"3\":",
            "            base = float(input(\"Ingrese la base del triángulo rectángulo: \"))",
            "            altura = float(input(\"Ingrese la altura del triángulo rectángulo: \"))",
            "",
            "            if base <= 0 or altura <= 0:",
            "                print(\"La base y la altura deben ser mayores que cero.\")",
            "                continue",
            "",
            "            triangulo = TrianguloRectangulo(base, altura)",
            "            print(f\"Área del triángulo rectángulo: {triangulo.area():.2f}\")",
            "            print(f\"Perímetro del triángulo rectángulo: {triangulo.perimetro():.2f}\")",
            "",
            "        else:",
            "            print(\"Opción no válida. Elija nuevamente.\")",
            "            continue",
            "",
            "    except ValueError:",
            "        print(\"Ingrese solamente valores numéricos válidos.\")",
            "        continue",
            "",
            "    # Se consulta si el usuario desea efectuar otro cálculo.",
            "    continuar = input(\"¿Desea realizar otro cálculo? (sí/no): \").lower()",
            "",
            "    if continuar != \"si\" and continuar != \"sí\":",
            "        print(\"Programa finalizado.\")",
            "        break"
        ],
        "description": "Calcula el área y perímetro de un círculo, cuadrilátero o triángulo rectángulo usando clases."
    },
