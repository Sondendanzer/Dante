    "basico_09_ecuacion_cuadratica_tres_casos": {
        "prefix": "basico_cuadratica",
        "body": [
            "# ENUNCIADO:",
            "# Resolver una ecuación cuadrática de la forma ax² + bx + c =",
            "# 0. Manejar los tres casos: dos raíces reales, una raíz doble",
            "# y raíces complejas.",
            "",
            "import math",
            "",
            "a = float(input(\"Ingrese el valor de a: \"))",
            "",
            "# El valor de a no puede ser cero porque dejaría de ser cuadrática.",
            "while a == 0:",
            "    print(\"El valor de a debe ser diferente de cero.\")",
            "    a = float(input(\"Ingrese nuevamente el valor de a: \"))",
            "",
            "b = float(input(\"Ingrese el valor de b: \"))",
            "c = float(input(\"Ingrese el valor de c: \"))",
            "",
            "# El discriminante permite identificar el tipo de raíces.",
            "discriminante = (b ** 2) - (4 * a * c)",
            "",
            "if discriminante > 0:",
            "    # Existen dos raíces reales diferentes.",
            "    x1 = (-b + math.sqrt(discriminante)) / (2 * a)",
            "    x2 = (-b - math.sqrt(discriminante)) / (2 * a)",
            "    print(f\"La primera raíz real es: {x1:.2f}\")",
            "    print(f\"La segunda raíz real es: {x2:.2f}\")",
            "elif discriminante == 0:",
            "    # Existe una raíz real doble.",
            "    x = -b / (2 * a)",
            "    print(f\"La ecuación tiene una raíz doble: {x:.2f}\")",
            "else:",
            "    # Existen dos raíces complejas.",
            "    parte_real = -b / (2 * a)",
            "    parte_imaginaria = math.sqrt(-discriminante) / (2 * a)",
            "    print(f\"La primera raíz compleja es: {parte_real:.2f} + {abs(parte_imaginaria):.2f}i\")",
            "    print(f\"La segunda raíz compleja es: {parte_real:.2f} - {abs(parte_imaginaria):.2f}i\")"
        ],
        "description": "Resuelve una ecuación cuadrática con raíces reales, dobles o complejas."
    },
